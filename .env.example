# =============================================================================
# Termux NodePanel — Environment Variables Configuration
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# =============================================================================

# --- Server & Network Configuration ---
# Port for the NodePanel daemon and web interface (default: 3000)
PORT=3000

# Node execution environment (development | production | test)
NODE_ENV=development

# Comma-separated list of additional allowed origins for CORS and WebSocket handshake
# (Localhost and cloud preview domains are permitted by default)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Security & Authentication ---
# Optional secret key for securing REST API endpoints and WebSocket connection
# If set, clients must pass this token via Bearer header or ?token= query parameter
API_SECRET_KEY=

# Maximum requests per rate-limiting window per IP address (default: 1200)
NODEPANEL_RATE_LIMIT_MAX=1200

# --- Storage & Persistence ---
# Directory where server workspaces, logs, and nodepanel.json are stored (default: ./data)
NODEPANEL_DATA_DIR=./data

# Optional external database connection URL (if integrating external database service)
DATABASE_URL=

# --- AI & Cloud Integrations ---
# Google Gemini API Key for server-side AI features and assistance
GEMINI_API_KEY=

# --- Development & Performance Tuning ---
# Disable Vite Hot Module Replacement to save CPU in constrained mobile/Termux environments (true | false)
DISABLE_HMR=false

# --- Frontend Metadata & Credits ---
# Project author name shown in About section
VITE_APP_AUTHOR=nellseen

# Author profile URL
VITE_APP_AUTHOR_URL=https://github.com/nellseen

# Source repository URL
VITE_APP_REPOSITORY_URL=https://github.com/nellseen/panel2